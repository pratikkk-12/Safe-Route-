# Copy this file to .env.local and fill in the values.
# PowerShell:  Copy-Item .env.example .env.local

# Neon Postgres connection string (Neon console > Connection Details, "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# OpenRouteService API key (free: https://openrouteservice.org/dev/#/signup). Server-side only.
ORS_API_KEY=

# Password for /admin (moderation queue)
ADMIN_PASSWORD=

# Random secret used to HMAC-hash reporter IPs for rate limiting
IP_HASH_SECRET=

# Secret for scheduled jobs (GitHub Actions)
CRON_SECRET=

# Map style (OpenFreeMap, no key needed)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
